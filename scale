# 1. Generate the 440Hz reference cue beep
ffmpeg -f lavfi -i "sine=frequency=440:duration=0.25" -af "volume=0.25" -ac 1 -ar 44100 beep.wav -y

# 2. Generate each note with clean, flat volume multipliers
ffmpeg -f lavfi -i "sine=frequency=4186:duration=2.25" -af "volume=0.25" -ac 1 -ar 44100 n0.wav -y
ffmpeg -f lavfi -i "sine=frequency=2093:duration=2.25" -af "volume=0.25" -ac 1 -ar 44100 n1.wav -y
ffmpeg -f lavfi -i "sine=frequency=1046:duration=2.25" -af "volume=0.25" -ac 1 -ar 44100 n2.wav -y
ffmpeg -f lavfi -i "sine=frequency=523:duration=2.25"  -af "volume=0.25" -ac 1 -ar 44100 n3.wav -y
ffmpeg -f lavfi -i "sine=frequency=261.6:duration=2.25" -af "volume=1.80" -ac 1 -ar 44100 n4.wav -y
ffmpeg -f lavfi -i "sine=frequency=130.8:duration=2.25" -af "volume=9.50" -ac 1 -ar 44100 n5.wav -y
ffmpeg -f lavfi -i "sine=frequency=65.4:duration=2.25"  -af "volume=18.00" -ac 1 -ar 44100 n6.wav -y
ffmpeg -f lavfi -i "sine=frequency=32.7:duration=2.25"  -af "volume=45.00" -ac 1 -ar 44100 n7.wav -y

# 3. Combine segments
ffmpeg -i n0.wav -i beep.wav -i n1.wav -i beep.wav -i n2.wav -i beep.wav -i n3.wav -i beep.wav -i n4.wav -i beep.wav -i n5.wav -i beep.wav -i n6.wav -i beep.wav -i n7.wav \
-filter_complex "[0:a][1:a][2:a][3:a][4:a][5:a][6:a][7:a][8:a][9:a][10:a][11:a][12:a][13:a][14:a]concat=n=15:v=0:a=1" \
scale.wav -y

rm beep.wav n0.wav n1.wav n2.wav n3.wav n4.wav n5.wav n6.wav n7.wav
